---
import { catById } from '../data/nav.js';
const { p } = Astro.props;
const cats = p.cats.map((id) => catById[id]).filter((c) => c && c.facet);
const series = cats.find((c) => c.facet === 'Σειρά') || cats[0];
const [a, b] = p.images;
const sizes = '(max-width: 760px) 46vw, (max-width: 1100px) 30vw, 280px';
const label = (p.name + ' ' + (p.sku || '') + ' ' + (series?.name || '')).toLowerCase();
---
<li class="pcard" data-cats={p.cats.join(' ')} data-tops={p.tops.join(' ')} data-name={label}>
  <a class="pc" href={`/products/${p.slug}/`}>
    <div class="pc-im">
      {a && <img class={b ? 'has-alt' : ''} src={a.src} srcset={a.srcset} sizes={sizes} width={a.w} height={a.h} alt={p.name} loading="lazy" decoding="async">}
      {b && <img class="alt" src={b.src} srcset={b.srcset} sizes={sizes} width={b.w} height={b.h} alt="" loading="lazy" decoding="async">}
      <span class="pc-more">Δείτε περισσότερα</span>
    </div>
    <div class="pc-tx">
      {series && <p class="pc-series">{series.name}</p>}
      <p class="pc-name">{p.name}</p>
    </div>
  </a>
</li>

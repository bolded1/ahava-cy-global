---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import ProductCard from '../components/ProductCard.astro';
import SocialList from '../components/SocialList.astro';
import site from '../data/site.json';
import P from '../data/products.json';
import { catBySlug } from '../data/nav.js';

const I = site.home_imgs;
const bySlug = Object.fromEntries(P.products.map((p) => [p.slug, p]));
const take = (slug, n = 8) => (catBySlug[slug]?.products || []).slice(0, n).map((s) => bySlug[s]).filter(Boolean);
const concerns = Object.values(catBySlug).filter((c) => c.top === 'prosopo' && c.facet === 'Ανάγκη');
const picks = [...take('youth-boosters', 4), ...take('apple-of-sodom', 3), ...take('hyaluronic-acid', 3)];
const seen = new Set();
const carousel = picks.filter((p) => (seen.has(p.slug) ? false : seen.add(p.slug)));
const shortcuts = [
  { href: '/category/prosopo/', label: 'Πρόσωπο', img: I.face },
  { href: '/category/soma/', label: 'Σώμα', img: I.body },
  { href: '/category/apple-of-sodom/', label: 'Apple of Sodom', img: I.aos },
  { href: '/category/for-him/', label: 'FOR HIM', img: bySlug[catBySlug['for-him']?.products[0]]?.images[0] },
  { href: '/category/paketa-kits/', label: 'Πακέτα', img: bySlug[catBySlug['paketa-kits']?.products[0]]?.images[0] },
].filter((s) => s.img);
const values = [
  { icon: I.i1, title: 'Χωρίς parabens' },
  { icon: I.i2, title: 'Vegan (όπως ήταν πάντα η AHAVA)' },
  { icon: I.i3, title: 'Δερματολογικά ελεγμένο για το ευαίσθητο δέρμα.' },
];
---
<Base title="AHAVA CY® – Dead Sea Mineral Skin Care Products" description="AHAVA στην Κύπρο: φόρμουλες που στηρίζονται σε φυσικά υλικά από τη Νεκρά Θάλασσα. Χωρίς parabens, vegan, δερματολογικά ελεγμένα. Βρείτε τα σε φαρμακεία." overlay image={I.aosScene.src}>
  <section class="hero">
    <article class="hero-slide is-on">
      <Img img={I.aosScene} eager sizes="100vw" alt={I.aosScene.alt} />
      <div class="hero-wash"></div>
      <div class="hero-copy">
        <p class="eyebrow">Πίσω από την AHAVA</p>
        <h1>Στην AHAVA πάμε βαθύτερα και από την ομορφιά.</h1>
        <p class="lead">Βασισμένη σε μια περιοχή πλούσια σε πόρους, αφήνουμε τη φύση να οδηγήσει την επιστήμη μας και να σχεδιάσει φόρμουλες που επικεντρώνονται στο να φέρουν την φύση κατ΄ευθείαν σε εσάς.</p>
        <a class="btn btn-light" href="/products/">Δείτε τα προϊόντα</a>
      </div>
    </article>
  </section>

  <section class="sec" id="face-body">
    <div class="wrap">
      <ul class="shortcuts">
        {shortcuts.map((s) => (
          <li>
            <a href={s.href}>
              <img src={s.img.src} srcset={s.img.srcset} alt="" width="88" height="88" loading="lazy">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Σειρές</p>
          <h2>Επιλογές</h2>
        </div>
        <a class="text-link" href="/products/">Όλα τα προϊόντα</a>
      </div>
      <div class="carousel" data-carousel>
        <button class="car-btn prev" type="button" aria-label="Προηγούμενα">‹</button>
        <ul class="rail">{carousel.map((p) => <ProductCard p={p} />)}</ul>
        <button class="car-btn next" type="button" aria-label="Επόμενα">›</button>
      </div>
    </div>
  </section>

  <section class="split">
    <div class="split-media"><Img img={I.sea} sizes="(max-width: 1024px) 100vw, 50vw" alt={I.sea.alt} /></div>
    <div class="split-copy">
      <p class="eyebrow">Η αφετηρία μας</p>
      <h2>Η υπόσχεσή μας</h2>
      <p>Φόρμουλες που στηρίζονται σε φυσικά υλικά. Συστατικά που έχουν χρησιμοποιηθεί για αιώνες. Και καινοτομία που τιμά την παράδοση. Χωρίς πρόσθετα, χωρίς περιττά, χωρίς απάτες.</p>
      <p>Τοποθετημένη στο σύγχρονο Ισραήλ, η περιοχή της Νεκράς Θάλασσας είναι πλούσια σε πρώτες ύλες. Οι επιστήμονες προσπάθησαν να κατανοήσουν σε βάθος τον τρόπο με τον οποίο τα μεταλλικά στοιχεία και τα φυτικά συστατικά μπορούν να βοηθήσουν και να βελτιώσουν το δέρμα, ιδρύοντας την AHAVA το 1988.</p>
      <a class="btn" href="/about/">Μάθε για την AHAVA</a>
    </div>
  </section>

  <section class="sec" id="needs">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Ανάγκη</p>
          <h2>Φροντίδα προσώπου ανά ανάγκη</h2>
        </div>
        <a class="text-link" href="/category/prosopo/">Όλη η φροντίδα προσώπου</a>
      </div>
      <ul class="concerns">
        {concerns.map((cat) => {
          const img = bySlug[cat.products[0]]?.images[0];
          return (
            <li>
              <a class="concern" href={`/category/${cat.slug}/`}>
                {img && <img class="pack" src={img.src} srcset={img.srcset} sizes="(max-width: 768px) 46vw, 22vw" width={img.w} height={img.h} alt="" loading="lazy" decoding="async">}
                <strong>{cat.name}</strong>
                <small>{cat.products.length} προϊόντα</small>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="sec band">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Νεκρά Θάλασσα</p>
          <h2>Τι δεν θα βρείτε στις φόρμουλες</h2>
        </div>
      </div>
      <ul class="values">
        {values.map((v) => (
          <li>
            <img src={v.icon.src} width="48" height="48" alt="">
            <h3>{v.title}</h3>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band-dark">
    <div class="wrap sec">
      <p class="eyebrow">Για φαρμακεία</p>
      <h2>Γνώρισε την AHAVA στο πελατολόγιο του φαρμακείου σου</h2>
      <div class="prose" set:html={site.pages.retailers_intro} />
      <div class="actions">
        <a class="btn btn-light" href="/synergasia/">Για φαρμακεία</a>
        <a class="btn btn-ghost" href="/where-to-buy/">Σημεία πώλησης</a>
      </div>
    </div>
  </section>

  <section class="sec" id="social">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">AHAVA</p>
          <h2>Ακολουθήστε μας</h2>
          <p class="lead" style="margin-top:12px">Facebook, Instagram και TikTok.</p>
        </div>
      </div>
      <SocialList links={site.socials} variant="cards" images={[I.aosScene, I.aosSalt, I.mud]} />
    </div>
  </section>

</Base>
